}

model LearnArticleTag {
  articleId String
  tagId     String
  article   LearnArticle @relation(fields: [articleId], references: [id], onDelete: Cascade)
  tag       LearnTag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([articleId, tagId])
  @@index([tagId])
}

model LearnMediaAsset {
  id         String                @id @default(uuid())
  articleId  String?
  revisionId String?
  url        String
  altText    String?
  provider   String?
