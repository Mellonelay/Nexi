enum OutboxDeliveryState {
  PENDING
  PUBLISHED
  RETRY
  DEAD_LETTERED
}

model EventOutbox {
  id             String              @id @default(uuid())
  idempotencyKey String              @unique
  aggregateType  String
  aggregateId    String
  eventType      String
  eventVersion   Int                 @default(1)
  correlationId  String?
  payload        String
  state          OutboxDeliveryState @default(PENDING)
  availableAt    DateTime            @default(now())
  claimedAt      DateTime?
  leaseToken     String?
  attempts       Int                 @default(0)
  lastErrorCode  String?
  lastErrorAt    DateTime?
  publishedAt    DateTime?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  @@index([state, availableAt])
  @@index([aggregateType, aggregateId, createdAt])
  @@index([correlationId, createdAt])
}

model EventInbox {
  messageId      String    @id
  queue          String
  attempts       Int
  eventType      String
  eventVersion   Int
  idempotencyKey String
  correlationId  String
  payload        String
  state          String    @default("RECEIVED")
  receivedAt     DateTime  @default(now())
  processedAt    DateTime?
  lastErrorCode  String?
  updatedAt      DateTime  @default(now())

  @@unique([queue, idempotencyKey])
  @@index([state, receivedAt])
}

model LearnArticle {
