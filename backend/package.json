{
  "name": "backend",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "pretest": "prisma generate",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/src/main.js",
    "generate:openapi": "node scripts/generate-openapi.js",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest",
    "test:watch": "NODE_OPTIONS=--experimental-vm-modules jest --watch",
    "test:cov": "NODE_OPTIONS=--experimental-vm-modules jest --coverage",
    "test:debug": "node --experimental-vm-modules --inspect-brk -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "NODE_OPTIONS=--experimental-vm-modules jest --config ./test/jest-e2e.json",
    "test:local-sqlite": "NODE_OPTIONS=--experimental-vm-modules jest --config test/jest-local-sqlite.config.cjs test/d1/d1-prisma-local-sqlite.spec.ts test/d1/local-sqlite-nest-provider.spec.ts test/d1/local-sqlite-bridge.service.spec.ts test/jobs/local-durable-job.store.spec.ts test/d1/wallet-account-transfer.local-sqlite.spec.ts test/d1/governance.local-sqlite.spec.ts test/d1/margin-closing-guard.local-sqlite.spec.ts test/d1/margin-close-recovery.local-sqlite.spec.ts test/jobs/local-workflow.store.spec.ts --runInBand",
    "test:all": "npm test -- --runInBand && npm run test:local-sqlite",
    "test:local-async": "NODE_OPTIONS=--experimental-vm-modules jest --config test/jest-local-async.config.cjs --runInBand"
  },
  "dependencies": {
    "@microsoft/signalr": "^10.0.11",
    "@nestjs/common": "^12.0.0",
    "@nestjs/config": "^12.0.0",
    "@nestjs/core": "^12.0.0",
    "@nestjs/jwt": "12.0.2",
    "@nestjs/mapped-types": "12.0.0",
    "@nestjs/passport": "12.0.0",
    "@nestjs/platform-express": "^12.0.0",
    "@nestjs/platform-socket.io": "^12.0.0",
    "@nestjs/schedule": "12.0.2",
    "@nestjs/serve-static": "12.0.0",
    "@nestjs/swagger": "^12.0.0",
    "@nestjs/websockets": "^12.0.0",
    "@prisma/adapter-better-sqlite3": "7.3.0",
    "@prisma/client": "7.3.0",
    "@sentry/nestjs": "11.0.0-rc.0",
    "@socket.io/redis-streams-adapter": "^0.3.0",
    "@spruceid/siwe-parser": "3.0.0",
    "bcrypt": "^6.0.0",
    "better-sqlite3": "12.11.1",
    "bullmq": "6.3.15",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.0",
    "ioredis": "^5.10.1",
    "otpauth": "^9.5.2",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "^7.8.1",
    "socket.io": "^4.8.3",
    "viem": "2.44.4",
    "ws": "^8.20.0"
  },
  "overrides": {
    "multer": "2.5.0",
    "browserslist": "4.28.7",
    "socket.io-adapter": {
      "ws": "8.21.0"
    },
    "viem": {
      "ws": "8.21.0"
    }
  },
  "devDependencies": {
    "@jest/globals": "^30.5.1",
    "@nestjs/bullmq": "12.0.0",
    "@nestjs/cli": "^12.0.0",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "^12.0.0",
    "@types/better-sqlite3": "9.6.0",
    "@types/express": "^4.17.17",
    "@types/jest": "30.0.0",
    "@types/node": "^20.19.30",
    "@types/supertest": "^2.0.12",
    "@types/ws": "^8.18.1",
    "eslint": "8.57.1",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-prettier": "^5.0.0",
    "jest": "30.5.1",
    "prettier": "^3.0.0",
    "prisma": "^7.10.1",
    "supertest": "^6.3.3",
    "ts-jest": "29.4.12",
    "ts-loader": "9.5.4",
    "ts-node": "^10.9.2",
    "typescript": "6.0.2"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": ".",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.ts$": [
        "ts-jest",
        {
          "useESM": true,
          "tsconfig": {
            "module": "ESNext",
            "target": "ES2022",
            "experimentalDecorators": true,
            "emitDecoratorMetadata": true,
            "esModuleInterop": true
          }
        }
      ]
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node",
    "setupFiles": [
      "<rootDir>/test/jest.setup.ts"
    ],
    "extensionsToTreatAsEsm": [
      ".ts"
    ],
    "transformIgnorePatterns": [],
    "modulePathIgnorePatterns": [
      "<rootDir>/dist/"
    ],
    "testPathIgnorePatterns": [
      "<rootDir>/test/d1/d1-prisma-local-sqlite.spec.ts",
      "<rootDir>/test/d1/local-sqlite-nest-provider.spec.ts",
      "<rootDir>/test/d1/local-sqlite-bridge.service.spec.ts",
      "<rootDir>/test/jobs/local-durable-job.store.spec.ts",
      "<rootDir>/test/d1/wallet-account-transfer.local-sqlite.spec.ts",
      "<rootDir>/test/d1/governance.local-sqlite.spec.ts",
      "<rootDir>/test/d1/margin-closing-guard.local-sqlite.spec.ts",
      "<rootDir>/test/d1/margin-close-recovery.local-sqlite.spec.ts",
      "<rootDir>/test/jobs/local-workflow.store.spec.ts"
    ]
  }
}
