  createdAt  DateTime              @default(now())
  article    LearnArticle?         @relation("ArticleMedia", fields: [articleId], references: [id], onDelete: Cascade)
  revision   LearnArticleRevision? @relation("RevisionMedia", fields: [revisionId], references: [id], onDelete: Cascade)

  @@index([articleId, createdAt])
  @@index([revisionId, createdAt])
}

model LegacySettings {
  id        String   @id
  key       String   @unique
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime

  @@map("Settings")
}

model UserPreference {
  id                   String   @id @default(uuid())
  userId               String   @unique
  locale               String   @default("en")
  timezone             String   @default("UTC")
  theme                String   @default("dark")
  notificationSettings Json?
  tradingSettings      Json?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Gate 2 authority models. These coexist with historical Float-backed
// projections so B4-B6 can adopt exact NUMERIC arithmetic without rewriting
// legacy rows or changing the completed B1-B3 lineage.
enum Gate2SpotOrderType {
  LIMIT
  MARKET
  STOP
}

enum Gate2SpotOrderStatus {
  OPEN
  PARTIALLY_FILLED
  FILLED
  CANCELED
  REJECTED
}

model Gate2SpotOrder {
  id                String               @id @default(uuid())
  userId            String
  pair              String
  baseAsset         String
  quoteAsset        String
  side              OrderSide
  type              Gate2SpotOrderType
  status            Gate2SpotOrderStatus @default(OPEN)
  amount            Decimal              @db.Decimal(38, 18)
  filled            Decimal              @default(0) @db.Decimal(38, 18)
  remaining         Decimal              @db.Decimal(38, 18)
  price             Decimal?             @db.Decimal(38, 18)
  stopPrice         Decimal?             @db.Decimal(38, 18)
  triggeredAt       DateTime?
  triggerQuoteId    String?
  triggerProvider   String?
  triggerSource     String?
  triggerObservedAt DateTime?
  triggerSequence   BigInt?
  reserveAsset      String
  reserveScope      LedgerAccountScope   @default(MAIN)
  reservedAmount    Decimal              @db.Decimal(38, 18)
  feeRate           Decimal              @default(0) @db.Decimal(38, 18)
  idempotencyKey    String
  correlationId     String
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  user              User                 @relation(fields: [userId], references: [id])
  tradesAsBuyer     Gate2SpotTrade[]     @relation("Gate2TradeBuyerOrder")
  tradesAsSeller    Gate2SpotTrade[]     @relation("Gate2TradeSellerOrder")

  @@unique([userId, idempotencyKey])
  @@index([pair, status, side, price, createdAt])
  @@index([userId, status, createdAt])
}

model Gate2SpotTrade {
  id             String         @id @default(uuid())
  buyerOrderId   String
  sellerOrderId  String
  pair           String
  baseAsset      String
  quoteAsset     String
  price          Decimal        @db.Decimal(38, 18)
  amount         Decimal        @db.Decimal(38, 18)
  buyerFee       Decimal        @default(0) @db.Decimal(38, 18)
  sellerFee      Decimal        @default(0) @db.Decimal(38, 18)
  idempotencyKey String         @unique
  createdAt      DateTime       @default(now())
  buyerOrder     Gate2SpotOrder @relation("Gate2TradeBuyerOrder", fields: [buyerOrderId], references: [id])
  sellerOrder    Gate2SpotOrder @relation("Gate2TradeSellerOrder", fields: [sellerOrderId], references: [id])

  @@index([pair, createdAt])
  @@index([buyerOrderId, createdAt])
  @@index([sellerOrderId, createdAt])
}

model Gate2BinaryConfiguration {
  id                     String   @id @default(uuid())
  pair                   String
  durationSeconds        Int
  payoutRate             Decimal  @db.Decimal(38, 18)
  lossRate               Decimal  @default(0) @db.Decimal(38, 18)
  minStake               Decimal  @db.Decimal(38, 18)
  maxStake               Decimal  @db.Decimal(38, 18)
  settlementDelaySeconds Int      @default(0)
  version                Int      @default(1)
  enabled                Boolean  @default(true)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  @@unique([pair, durationSeconds, version])
  @@index([pair, enabled])
}

enum Gate2BinaryState {
  ACTIVE
  SETTLING
  SETTLEMENT_DELAYED
  WIN
  LOSS
  ERROR
}

model Gate2BinaryPosition {
  id                   String           @id @default(uuid())
  userId               String
  pair                 String
  side                 BinarySide
  stake                Decimal          @db.Decimal(38, 18)
  entryPrice           Decimal          @db.Decimal(38, 18)
  expiryPrice          Decimal?         @db.Decimal(38, 18)
  payoutAmount         Decimal          @default(0) @db.Decimal(38, 18)
  realizedProfit       Decimal          @default(0) @db.Decimal(38, 18)
  durationSeconds      Int
  expiresAt            DateTime
  state                Gate2BinaryState @default(ACTIVE)
  entryQuoteId         String
  entryProvider        String
  entrySource          String
  entryObservedAt      DateTime
  entryReceivedAt      DateTime
  entrySequence        BigInt
  expiryQuoteId        String?
  expiryProvider       String?
  expirySource         String?
  expiryObservedAt     DateTime?
  expiryReceivedAt     DateTime?
  expirySequence       BigInt?
  quoteFreshnessMs     Int
  configurationVersion Int
  settlementReceiptId  String?          @unique
  idempotencyKey       String
  correlationId        String
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt
  user                 User             @relation(fields: [userId], references: [id])

  @@unique([userId, idempotencyKey])
  @@index([userId, state, createdAt])
  @@index([pair, state, createdAt])
}

enum Gate2DepositState {
  OBSERVED
  CONFIRMING
  CREDITED
  REJECTED
  UNAVAILABLE
}

model Gate2Deposit {
  id                    String            @id @default(uuid())
  userId                String
  asset                 String
  network               String
  address               String
  txHash                String
  amount                Decimal           @db.Decimal(38, 18)
  confirmations         Int               @default(0)
  requiredConfirmations Int
  state                 Gate2DepositState @default(OBSERVED)
  observationKey        String            @unique
  creditPostingId       String?
  observedAt            DateTime          @default(now())
  creditedAt            DateTime?
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt
  user                  User              @relation(fields: [userId], references: [id])

  @@unique([network, txHash, address])
  @@index([userId, state, createdAt])
}

enum Gate2WithdrawalState {
  PENDING_REVIEW
  REJECTED
  APPROVED
  SETTLED
  FAILED
}

model Gate2Withdrawal {
  id             String               @id @default(uuid())
  userId         String
  asset          String
  network        String
  address        String
  amount         Decimal              @db.Decimal(38, 18)
  fee            Decimal              @db.Decimal(38, 18)
  reservedAmount Decimal              @db.Decimal(38, 18)
  state          Gate2WithdrawalState @default(PENDING_REVIEW)
  requestKey     String               @unique
  reserveKey     String               @unique
  reviewReason   String?
  txHash         String?
  providerState  String?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  user           User                 @relation(fields: [userId], references: [id])

  @@index([userId, state, createdAt])
}

model Gate2InternalTransfer {
  id              String   @id @default(uuid())
  fromUserId      String
  toUserId        String
  asset           String
  amount          Decimal  @db.Decimal(38, 18)
  idempotencyKey  String   @unique
