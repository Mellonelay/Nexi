model SpotMarginPosition {
  id                 String                      @id @default(uuid())
  accountId          String
  direction          SpotMarginPositionDirection
  leverage           Int
  collateral         Decimal                     @db.Decimal(38, 18)
  quantity           Decimal                     @default(0) @db.Decimal(38, 18)
  entryPrice         Decimal                     @db.Decimal(38, 18)
  markPrice          Decimal?                    @db.Decimal(38, 18)
  debtAsset          String                      @default("")
  debtPrincipal      Decimal                     @default(0) @db.Decimal(38, 18)
  interestAccrued    Decimal                     @default(0) @db.Decimal(38, 18)
