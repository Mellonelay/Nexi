import { Container, getContainer } from "@cloudflare/containers";
export { ContainerProxy } from "@cloudflare/containers";

/**
 * The Worker is an edge gateway only. NestJS remains the API, market, wallet,
 * ledger, and Socket.IO authority. Container.fetch preserves HTTP polling and
 * WebSocket upgrades; no Worker-generated financial or market payloads are
 * permitted here.
 */
export class NexiApiContainer extends Container {
  defaultPort = 3000;
  sleepAfter = "48h";
  pingEndpoint = "localhost/ops/live";

  onStart() {
    console.log("NEXI_CONTAINER_ONSTART", { port: this.defaultPort });
  }

  onStop({ exitCode, reason } = {}) {
    console.log("NEXI_CONTAINER_ONSTOP", { exitCode, reason });
  }

  onError(error) {
    console.error("NEXI_CONTAINER_ONERROR", error);
    throw error;
  }
}

/**
 * Containers cannot receive D1 bindings directly. Cloudflare's documented
 * outbound Worker hook lets the container call this handler over the private
 * virtual host `http://nexi-core-d1`, while the handler uses the CORE_DB D1
 * binding in the Workers runtime. Keep the bridge intentionally narrow: it
 * supports bounded read queries and named health checks, never public SQL.
 */
NexiApiContainer.outboundByHost = {
  "nexi-core-d1": async (request, env) => {
    const url = new URL(request.url);
    if (url.pathname === "/health" && request.method === "GET") {
      const result = await env.CORE_DB.prepare("SELECT 1 AS ok").first();
      return Response.json({ ok: result?.ok === 1, servedByPrimary: true });
    }

    if (url.pathname === "/batch" && request.method === "POST") {
      const body = await request.json().catch(() => null);
      const statements = body && Array.isArray(body.statements) ? body.statements : [];
      if (statements.length < 1 || statements.length > 16) {
        return Response.json({ error: "Batch requires between 1 and 16 statements" }, { status: 400 });
      }
      const prepared = [];
      for (const item of statements) {
        const statement = item && typeof item.sql === "string" ? item.sql.trim() : "";
        const params = item && Array.isArray(item.params) ? item.params : [];
        if (!statement || statement.length > 16_384 || statement.includes(";")) {
          return Response.json({ error: "Only one bounded SQL statement is accepted per item" }, { status: 400 });
        }
        if (!/^(SELECT|INSERT|UPDATE|DELETE|REPLACE)\b/i.test(statement)) {
          return Response.json({ error: "Batch accepts only data statements" }, { status: 403 });
        }
        if (params.length > 64 || params.some((value) =>
          value !== null && !["string", "number", "boolean"].includes(typeof value))) {
          return Response.json({ error: "Unsupported parameter type" }, { status: 400 });
        }
        prepared.push(env.CORE_DB.prepare(statement).bind(...params));
      }
      const results = await env.CORE_DB.batch(prepared);
      return Response.json({ results });
    }

    if (url.pathname !== "/query" || request.method !== "POST") {
      return new Response("Not found", { status: 404 });
    }

    const body = await request.json().catch(() => null);
    const sql = body && typeof body.sql === "string" ? body.sql.trim() : "";
    const params = body && Array.isArray(body.params) ? body.params : [];
    if (!sql || sql.length > 16_384 || sql.includes(";")) {
      return Response.json({ error: "Only one bounded SQL statement is accepted" }, { status: 400 });
    }
    if (!/^SELECT\b/i.test(sql)) {
      return Response.json({ error: "The bridge query endpoint is read-only" }, { status: 403 });
    }
    if (params.some((value) => value !== null && ["string", "number"].includes(typeof value) === false)) {
      return Response.json({ error: "Unsupported parameter type" }, { status: 400 });
    }

    const result = await env.CORE_DB.prepare(sql).bind(...params).all();
    return Response.json({ results: result.results, meta: result.meta });
  },

};

const CONTAINER_ENV_KEYS = [
  "NODE_ENV", "PORT", "DATABASE_POOL_MAX", "DATABASE_URL", "REDIS_URL", "JWT_SECRET",
  "D1_RUNTIME_ENABLED", "D1_BRIDGE_ENABLED", "D1_BRIDGE_HOST",
  "CORS_ORIGINS", "WALLET_AUTH_DOMAIN", "WALLET_AUTH_URI", "WALLET_AUTH_SUPPORTED_CHAIN_IDS",
  "MARKET_PROVIDER_ENABLED", "MARKET_PROVIDER_NAME", "MARKET_PROVIDER_NAMES", "MARKET_PROVIDER_SYMBOLS",
  "MARKET_PROVIDER_WS_URL", "MARKET_PROVIDER_HTTP_URL", "MARKET_PROVIDER_POLL_INTERVAL_MS",
  "MARKET_QUOTE_STALE_AFTER_MS", "NEXI_MARKET_STALE_AFTER_MS", "NEXI_CONVERSION_QUOTE_TTL_MS",
  "MARKET_BACKFILL_ON_STARTUP", "NEXI_SCHEDULER_ENABLED", "NEXI_B7_ENABLED", "NEXI_SANDBOX_ACCOUNT_IDS",
  "MARKET_ARCHIVE_PIPELINE_URL", "MARKET_ARCHIVE_PIPELINE_TOKEN", "MARKET_ARCHIVE_REQUIRED",
  "MARKET_REFERENCE_RETENTION_SECONDS",
  "ALPHA_VANTAGE_API_BASE_URL", "ALPHA_VANTAGE_API_KEY", "FAWAZ_CURRENCY_API_BASE_URL",
  "FINNHUB_API_BASE_URL", "FINNHUB_API_KEY", "MASSIVE_API_BASE_URL", "MASSIVE_API_KEY",
  "METALPRICE_API_BASE_URL", "METALPRICE_API_KEY", "METALS_API_BASE_URL", "METALS_API_KEY",
  "METALS_API_QUOTE_DIRECTION", "OANDA_API_BASE_URL", "OANDA_ACCESS_TOKEN", "OANDA_ACCOUNT_ID",
  "RZZRO_API_BASE_URL", "TICKDB_API_KEY", "TICKDB_HTTP_URL", "TICKDB_WS_URL"
];

function containerEnv(env) {
  return Object.fromEntries(
    CONTAINER_ENV_KEYS
      .filter((key) => env[key] !== undefined)
      .map((key) => [key, String(env[key])])
  );
}

export default {
  async fetch(request, env) {
    const url = new URL(request.url);
    const container = getContainer(env.NEXI_API_CONTAINER, "nexi-api");
    const startOptions = { envVars: containerEnv(env) };

    if (url.pathname === "/healthz") {
      return Response.json({ ok: true, status: "UP", service: "nexi-edge" });
    }

    if (url.pathname === "/storage/deposit-proof" && request.method === "PUT") {
      const key = url.searchParams.get("key") ?? "";
      const authorization = request.headers.get("authorization");
      const contentType = request.headers.get("content-type") ?? "";
      const contentLength = Number(request.headers.get("content-length") ?? 0);
      if (!authorization || !key) return new Response("Unauthorized", { status: 401 });
      if (!/^image\/(png|jpeg|webp|gif)$/.test(contentType) || contentLength > 10 * 1024 * 1024) {
        return new Response("Unsupported or oversized deposit proof", { status: 413 });
      }
      await container.start(startOptions);
      const check = await container.fetch(new Request(new URL("/financial/deposit-proof-upload/authorize", request.url), {
        method: "POST",
        headers: { authorization, "content-type": "application/json" },
        body: JSON.stringify({ key }),
      }));
      if (!check.ok) return new Response("Deposit proof upload is not authorized", { status: check.status });
      await env.DEPOSIT_PROOFS.put(key, request.body, { httpMetadata: { contentType } });
      return Response.json({ key, status: "UPLOADED" });
    }

    if (url.pathname === "/financial/deposit-claims" && request.method === "POST") {
      const body = await request.clone().json().catch(() => null);
      const proofKey = body && typeof body === "object" && typeof body.proofObjectKey === "string" ? body.proofObjectKey : "";
      if (!proofKey || !(await env.DEPOSIT_PROOFS.head(proofKey))) {
        return Response.json({ statusCode: 422, message: "Deposit proof object is not available" }, { status: 422 });
      }
    }

    // Pass the runtime environment once, then use the canonical Container
    // fetch path for both HTTP and WebSocket forwarding. fetch() owns the
    // readiness wait and can wake the Durable Object instance when needed.
    await container.startAndWaitForPorts({
      ports: [3000],
      startOptions,
      cancellationOptions: { portReadyTimeoutMS: 30_000 },
    });
    return container.fetch(request);
  },
};
