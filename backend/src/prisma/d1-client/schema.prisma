  user           User                     @relation(fields: [userId], references: [id])
  account        SpotMarginAccount?       @relation(fields: [accountId], references: [id])
  position       SpotMarginPosition?      @relation(fields: [positionId], references: [id])

  @@index([userId, createdAt])
  @@index([accountId, createdAt])
  @@index([positionId, createdAt])
}

model LedgerPosting {
