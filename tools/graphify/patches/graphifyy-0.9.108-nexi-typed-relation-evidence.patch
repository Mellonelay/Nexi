+def _path_edge_facts(data: dict, nodes: set[str] | None = None) -> list[dict]:
+    """Expand source-directed NEXI facts stored on a simple graph edge.
+
+    Keep the original edge as fallback for unmodified upstream graphs. Only
+    trust secondary facts whose logical endpoints exist and are in the same
+    endpoint pair as their primary edge (checked by the caller).
+    """
+    variants = data.get("parallel_relations")
+    if not isinstance(variants, list) or len(variants) < 2:
+        return [data]
+    facts = []
+    for fact in variants:
+        if not isinstance(fact, dict) or fact.get("context") not in {
+            "nexi", "http", "react_context", "css"
+        }:
+            continue
+        src, tgt = fact.get("_src"), fact.get("_tgt")
+        if not isinstance(src, str) or not isinstance(tgt, str):
+            continue
+        if nodes is not None and (src not in nodes or tgt not in nodes):
+            continue
+        facts.append(fact)
+    return facts if facts else [data]
