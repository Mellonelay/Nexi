model SpotMarginPosition {
  id                 String                      @id @default(uuid())
  accountId          String
  direction          SpotMarginPositionDirection
  leverage           Int
  collateral         String
  quantity           String                      @default("0")
  entryPrice         String
  markPrice          String?
