+def _nexi_relation_variants(existing: dict, incoming: dict) -> list[dict] | None:
+    """Keep distinct NEXI edge facts when a simple graph collapses a node pair.
+
+    Native Graph/DiGraph still has one primary edge per pair for compatibility.
+    This sidecar is *evidence*, not an independently traversable graph edge.
+    Same-relation repeated provenance remains owned by ``also_seen``.
+    """
+    old = existing.get("parallel_relations")
+    new = incoming.get("parallel_relations")
+    # Preserve all NEXI native adapters, not only the framework context:
+    # HTTP, React Context and CSS are emitted under their own provenance tags.
+    nexi_contexts = {"nexi", "http", "react_context", "css"}
+    if not (existing.get("context") in nexi_contexts
+            or incoming.get("context") in nexi_contexts
+            or isinstance(old, list) or isinstance(new, list)):
+        return None
+
+    allowed = ("relation", "_src", "_tgt", "context", "confidence",
+               "confidence_score", "source_file", "source_location")
+    variants: dict[tuple[str, str, str], dict] = {}
+    for edge in (existing, incoming):
+        members = edge.get("parallel_relations")
+        candidates = members if isinstance(members, list) else [edge]
+        for item in candidates:
+            if not isinstance(item, dict) or not item.get("relation"):
+                continue
+            record = {key: item[key] for key in allowed if key in item}
+            key = (str(record.get("relation")), str(record.get("_src")),
+                   str(record.get("_tgt")))
+            variants.setdefault(key, record)
+    # A sole relation has no parallel fact; keep any preexisting sidecar intact.
+    if len(variants) < 2:
+        return old if isinstance(old, list) else new if isinstance(new, list) else None
+    return [variants[key] for key in sorted(variants)]
+
 
