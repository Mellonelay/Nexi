  @@index([status, publishedAt])
  @@index([categoryId, status])
  @@map("LearnContent")
}

model LearnCategory {
  id          String         @id @default(uuid())
  slug        String         @unique
  name        String
  description String?
  sortOrder   Int            @default(0)
  status      String         @default("ACTIVE")
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
