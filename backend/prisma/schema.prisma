  @@unique([providerId, providerSymbol])
  @@index([pairId, enabled])
}

enum MarketTradeSide {
  BUY
  SELL
  UNKNOWN
}

model MarketTrade {
  id              String          @id @default(uuid())
  pairId          String
  symbol          String
  provider        String
  source          String
  providerTradeId String?
  sequence        BigInt?
