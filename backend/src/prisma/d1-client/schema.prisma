model LearnArticleRevision {
  id          String            @id @default(uuid())
  articleId   String
  revision    Int
  title       String
  body        String
  summary     String?
  status      String            @default("DRAFT")
  attachments String?
  scheduledAt DateTime?
  publishedAt DateTime?
  archivedAt  DateTime?
  createdBy   String?
  createdAt   DateTime          @default(now())
  article     LearnArticle      @relation(fields: [articleId], references: [id], onDelete: Cascade)
  media       LearnMediaAsset[] @relation("RevisionMedia")

