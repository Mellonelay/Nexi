+def _incoming_source_facts(graph: nx.Graph, current: str):
+    """Yield true incoming facts, including NEXI relations sharing an edge pair.
+
+    Ordinary Graphify edges retain their previous traversal contract. NEXI's
+    ``_src``/``_tgt`` and ``parallel_relations`` record the source-proven arc
+    even when an undirected builder stored the primary edge reversed.
+    """
+    if hasattr(graph, "in_edges"):
+        # A saved simple graph is loaded as directed. Its secondary NEXI arc
+        # may point against that storage direction, so inspect both incidents.
+        edges = (*graph.in_edges(current, data=True),
+                 *graph.out_edges(current, data=True))
+    else:
+        edges = graph.edges(current, data=True)
+    seen: set[tuple] = set()
+    for source, target, data in edges:
+        variants = data.get("parallel_relations")
+        facts = variants if isinstance(variants, list) and len(variants) > 1 else [data]
+        if not facts:
+            continue
+        for fact in facts:
+            if not isinstance(fact, dict):
+                continue
+            has_nexi_direction = (
+                fact.get("context") in {"nexi", "http", "react_context", "css"}
+                and "_src" in fact and "_tgt" in fact
+            )
+            if has_nexi_direction:
+                logical_source, logical_target = fact["_src"], fact["_tgt"]
+                if logical_target != current or logical_source not in graph:
+                    continue
+            else:
+                # Do not reinterpret upstream ordinary directed-graph edges.
+                if target != current:
+                    continue
+                logical_source, logical_target = source, target
+            key = (id(data), str(logical_source), str(logical_target),
+                   str(fact.get("relation")), str(fact.get("source_file")),
+                   str(fact.get("source_location")))
+            if key not in seen:
+                seen.add(key)
+                yield logical_source, logical_target, fact
 
 
