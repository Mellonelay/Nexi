  creditPostingId String
  createdAt       DateTime @default(now())
  fromUser        User     @relation("Gate2TransferFrom", fields: [fromUserId], references: [id])
  toUser          User     @relation("Gate2TransferTo", fields: [toUserId], references: [id])

  @@index([fromUserId, createdAt])
  @@index([toUserId, createdAt])
}

enum Gate2ConversionQuoteState {
  OPEN
  ACCEPTED
  EXPIRED
  REJECTED
}

model Gate2ConversionQuote {
  id                   String                    @id @default(uuid())
  userId               String
  fromAsset            String
  toAsset              String
  inputAmount          Decimal                   @db.Decimal(38, 18)
  rate                 Decimal                   @db.Decimal(38, 18)
  outputAmount         Decimal                   @db.Decimal(38, 18)
  provider             String
  source               String
  evidenceId           String
  configurationVersion Int
  expiresAt            DateTime
  state                Gate2ConversionQuoteState @default(OPEN)
  quoteKey             String                    @unique
  acceptanceKey        String?                   @unique
  conversionRef        String?
  createdAt            DateTime                  @default(now())
  updatedAt            DateTime                  @updatedAt
  user                 User                      @relation(fields: [userId], references: [id])

  @@index([userId, state, expiresAt])
}

model Gate2OperationAudit {
  id             String   @id @default(uuid())
  userId         String
  operationType  String
  operationId    String
  eventType      String
  idempotencyKey String
  details        Json?
  createdAt      DateTime @default(now())
  user           User     @relation(fields: [userId], references: [id])

  @@index([operationType, operationId, createdAt])
  @@index([userId, createdAt])
  @@index([idempotencyKey])
}
