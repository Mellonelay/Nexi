generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                    String                  @id @default(uuid())
  userCode              Int                     @unique
  email                 String?                 @unique
  password              String?
  displayName           String?
  role                  Role                    @default(USER)
  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @updatedAt
  lastActive            DateTime                @default(now())
  binaryPositions       BinaryOptionPosition[]
  kyc                   KYC?
  loans                 LoanApplication[]
  wallet                Wallet?
  withdrawalRequests    WithdrawalRequest[]
  forceOutcome          String                  @default("NORMAL")
  contractPositions     ContractPosition[]
  authSessions          AuthSession[]
  spotOrders            SpotOrder[]
  spotTrades            SpotTrade[]
  conversions           ConversionTransaction[]
  miningSubscriptions   MiningSubscription[]
  affiliate             LegacyAffiliate?
  rewards               LegacyReward[]
  ledgerAccounts        LedgerAccount[]
  miningRewardAccruals  MiningRewardAccrual[]
  gate2SpotOrders       Gate2SpotOrder[]
  gate2BinaryPositions  Gate2BinaryPosition[]
  gate2Deposits         Gate2Deposit[]
  depositClaims         DepositClaim[]          @relation("DepositClaimOwner")
  reviewedDepositClaims DepositClaim[]          @relation("DepositClaimReviewer")
  gate2Withdrawals      Gate2Withdrawal[]
  gate2ConversionQuotes Gate2ConversionQuote[]
  gate2OperationAudits  Gate2OperationAudit[]
  gate2TransfersFrom    Gate2InternalTransfer[] @relation("Gate2TransferFrom")
  gate2TransfersTo      Gate2InternalTransfer[] @relation("Gate2TransferTo")
  adminRoleAssignment   AdminRoleAssignment?
  walletIdentity        WalletIdentity?
  spotMarginAccounts    SpotMarginAccount[]
  spotMarginActivities  SpotMarginActivity[]
  activities            Activity[]
  preference            UserPreference?
}

model WalletIdentity {
  id        String   @id @default(uuid())
  userId    String   @unique
  address   String   @unique
  chainId   Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([address, chainId])
}

enum AuthSessionSurface {
  PUBLIC
  ADMIN
}

model AuthSession {
  id                String             @id @default(uuid())
  userId            String
  surface           AuthSessionSurface
  tokenFamilyId     String
  refreshTokenHash  String             @unique
  createdAt         DateTime           @default(now())
  lastUsedAt        DateTime           @default(now())
  absoluteExpiresAt DateTime
  idleExpiresAt     DateTime
  revokedAt         DateTime?
  revokeReason      String?
  replacedById      String?
  userAgentHash     String?
  ipHash            String?
  user              User               @relation(fields: [userId], references: [id])

  @@index([userId, surface, revokedAt])
  @@index([tokenFamilyId, revokedAt])
  @@index([absoluteExpiresAt])
  @@index([idleExpiresAt])
}

model KYC {
  id           String   @id @default(uuid())
  userId       String   @unique
  firstName    String
  lastName     String
  dob          DateTime
  country      String
  documentType String
  documentUrl  String
  status       String   @default("PENDING")
  idFront      String?
  idBack       String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id])
}

model Wallet {
  id            String   @id @default(uuid())
  userId        String   @unique
  balance       Float    @default(0)
  frozenBalance Float    @default(0)
  balances      Json     @default("{}")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @default(now())
  ledgers       Ledger[]
  user          User     @relation(fields: [userId], references: [id])
}

model Ledger {
  id              String            @id @default(uuid())
  walletId        String
  type            LedgerType
  amount          Float
  currency        String
  referenceId     String?
  transactionType TransactionType   @default(DEPOSIT)
  status          TransactionStatus @default(CONFIRMED)
  createdAt       DateTime          @default(now())
  wallet          Wallet            @relation(fields: [walletId], references: [id])

  @@index([walletId])
}

model SpotOrder {
  id        String      @id @default(uuid())
  userId    String
  symbol    String
  pair      String
  side      OrderSide
  type      OrderType
  price     Float?
  amount    Float
  filled    Float       @default(0)
  remaining Float       @default(0)
  status    OrderStatus @default(OPEN)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  user      User        @relation(fields: [userId], references: [id])
  trades    SpotTrade[]
}

model SpotTrade {
  id          String    @id @default(uuid())
  orderId     String
  userId      String
  pair        String
  side        OrderSide
  price       Float
  amount      Float
  fee         Float     @default(0)
  feeCurrency String    @default("USDT")
  createdAt   DateTime  @default(now())
  order       SpotOrder @relation(fields: [orderId], references: [id])
  user        User      @relation(fields: [userId], references: [id])
}

model BinaryOptionPosition {
  id             String                     @id @default(uuid())
  userId         String
  symbol         String
  pair           String?
  side           BinarySide
  amount         Float
  entryPrice     Float
  timeframe      Int
  payoutRate     Float?
  profitRatio    Int?
  lossRatio      Int?
  targetPayout   Float?
  closePrice     Float?
  realizedProfit Float?
  strikePrice    Float?
  payout         Float?
  duration       Int?
  status         BinaryStatus               @default(OPEN)
  expiresAt      DateTime
  createdAt      DateTime                   @default(now())
  updatedAt      DateTime                   @updatedAt
  user           User                       @relation(fields: [userId], references: [id])
  legacyResults  LegacyBinaryOptionResult[]

  @@index([status])
  @@index([userId])
}

model ContractPosition {
  id               String   @id @default(uuid())
  userId           String
  symbol           String // e.g. BTC/USDT
  side             String // BUY (Long) or SELL (Short)
  amount           Float // Margin Amount (Collateral)
  leverage         Int // e.g. 100
  entryPrice       Float
  currentPrice     Float? // Last updated price
  liquidationPrice Float
  tpPrice          Float? // Take Profit
  slPrice          Float? // Stop Loss
  status           String // OPEN, CLOSED, LIQUIDATED
  pnl              Float    @default(0)
  fee              Float    @default(0)
  marginMode       String   @default("ISOLATED") // CROSS or ISOLATED
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  user             User     @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([status])
}

model ContractPair {
  id          String  @id @default(uuid())
  symbol      String  @unique
  minLeverage Int     @default(1)
  maxLeverage Int     @default(100)
  makerFee    Float   @default(0.0004)
  takerFee    Float   @default(0.0006)
  minAmount   Float   @default(10)
  isActive    Boolean @default(true)
}

model ConversionTransaction {
  id        String   @id @default(uuid())
  userId    String
  fromCoin  String
  toCoin    String
  amount    Float
  rate      Float
  received  Float
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
}

model LoanApplication {
  id                    String                @id @default(uuid())
  userId                String
  amount                Float
  amountDecimal         Decimal               @default(0) @db.Decimal(38, 18)
  currency              String                @default("USDT")
  term                  Int
  durationDays          Int                   @default(30)
  interestRate          Float                 @default(0.1)
  interestRateDecimal   Decimal               @default(0.1) @db.Decimal(38, 18)
  totalRepayment        Float                 @default(0)
  totalRepaymentDecimal Decimal               @default(0) @db.Decimal(38, 18)
  collateral            String?
  collateralImg         String?
  status                LoanStatus            @default(PENDING)
  approvedAt            DateTime?
  dueDate               DateTime?
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @default(now())
  productSnapshot       Json?
  user                  User                  @relation(fields: [userId], references: [id])
  repayments            LegacyLoanRepayment[]

  @@index([userId])
}

model MiningPlan {
  id                String               @id @default(uuid())
  name              String
  currency          String               @default("USDT")
  lockupPeriod      Int
  dailyYield        Float
  dailyYieldDecimal Decimal              @default(0) @db.Decimal(38, 18)
  minDeposit        Float
  minDepositDecimal Decimal              @default(0) @db.Decimal(38, 18)
  maxDeposit        Float
  maxDepositDecimal Decimal              @default(0) @db.Decimal(38, 18)
  isActive          Boolean              @default(true)
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  subscriptions     MiningSubscription[]
}

model MiningSubscription {
  id                  String                @id @default(uuid())
  userId              String
  planId              String
  amount              Float
  amountDecimal       Decimal               @default(0) @db.Decimal(38, 18)
  status              MiningStatus          @default(ACTIVE)
  startDate           DateTime              @default(now())
  endDate             DateTime?
  totalRewards        Float                 @default(0)
  totalRewardsDecimal Decimal               @default(0) @db.Decimal(38, 18)
  lastRewardPaid      DateTime?
  planSnapshot        Json?
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @default(now())
  user                User                  @relation(fields: [userId], references: [id])
  plan                MiningPlan            @relation(fields: [planId], references: [id])
  accruals            MiningRewardAccrual[]

  @@index([planId])
}

// Durable reward evidence. LedgerPosting and Activity remain authoritative;
// this row is the mining-domain projection that links the reward event back to
// both authorities without duplicating balance truth.
model MiningRewardAccrual {
  id              String             @id @default(uuid())
  subscriptionId  String
  userId          String
  ledgerPostingId String             @unique
  activityId      String             @unique
  idempotencyKey  String             @unique
  amount          Decimal            @db.Decimal(38, 18)
  currency        String
  rewardedAt      DateTime           @default(now())
  subscription    MiningSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  user            User               @relation(fields: [userId], references: [id])
  ledgerPosting   LedgerPosting      @relation(fields: [ledgerPostingId], references: [id])
  activity        Activity           @relation(fields: [activityId], references: [id])

  @@index([subscriptionId, rewardedAt])
  @@index([userId, rewardedAt])
}

model Currency {
  id                Int              @id @default(autoincrement())
  symbol            String           @unique
  name              String
  logo              String?
  rate              Float            @default(1.0)
  minDeposit        Float            @default(10.0)
  maxDeposit        Float            @default(10000.0)
  minWithdrawal     Float            @default(10.0)
  maxWithdrawal     Float            @default(10000.0)
  withdrawalFee     Float            @default(1.0)
  depositEnabled    Boolean          @default(true)
  withdrawEnabled   Boolean          @default(true)
  confirmationCount Int              @default(3)
  decimals          Int              @default(18)
  isActive          Boolean          @default(true)
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  depositAddresses  DepositAddress[]
}

model DepositAddress {
  id           String         @id @default(uuid())
  currencyId   Int
  currency     Currency       @relation(fields: [currencyId], references: [id])
  network      String // e.g., "ERC20", "TRC20", "BTC"
  address      String
  label        String? // e.g., "Main Wallet"
  isActive     Boolean        @default(true)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  manualClaims DepositClaim[]

  @@index([currencyId])
}

enum DepositClaimState {
  PENDING_REVIEW
  APPROVED
  REJECTED
  CREDITED
  FAILED
}

// Manual user-submitted funding evidence is intentionally separate from
// Gate2Deposit, whose semantics remain blockchain/provider observation.
model DepositClaim {
  id                         String            @id @default(uuid())
  userId                     String
  asset                      String
  network                    String
  depositAddressId           String?
  destinationAddressSnapshot String
  claimedAmount              Decimal           @db.Decimal(38, 18)
  proofObjectKey             String
  proofContentType           String?
  proofByteSize              Int?
  txHash                     String?
  state                      DepositClaimState @default(PENDING_REVIEW)
  idempotencyKey             String            @unique
  submittedAt                DateTime          @default(now())
  reviewedAt                 DateTime?
  reviewedBy                 String?
  reviewReason               String?
  creditedLedgerPostingId    String?
  linkedObservedDepositId    String?
  user                       User              @relation("DepositClaimOwner", fields: [userId], references: [id])
  reviewer                   User?             @relation("DepositClaimReviewer", fields: [reviewedBy], references: [id])
  depositAddress             DepositAddress?   @relation(fields: [depositAddressId], references: [id], onDelete: SetNull)

  @@index([userId, state, submittedAt])
  @@index([state, submittedAt])
  @@index([txHash])
}

model LoanPlan {
  id           String   @id @default(uuid())
  name         String
  durationDays Int
  interestRate Float // e.g., 0.05 for 5%
  minAmount    Float
  maxAmount    Float
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model SystemConfig {
  id          String   @id @default(uuid())
  key         String   @unique // e.g., "banner_text", "maintenance_mode"
  value       String // JSON string or plain text
  description String?
  updatedAt   DateTime @updatedAt
}

model AdminAuditLog {
  id        String   @id @default(uuid())
  adminId   String
  action    String
  target    String?
  details   Json?
  ipAddress String?
  createdAt DateTime @default(now())

  @@index([adminId])
}

enum AdminRoleId {
  readonly_operator
  support_agent
  kyc_reviewer
  finance_operator
  market_operator
  content_manager
  security_auditor
  sandbox_operator
  super_admin
}

model AdminRoleAssignment {
  id         String      @id @default(uuid())
  userId     String      @unique
  roleId     AdminRoleId
  assignedBy String?
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([roleId])
}

enum AdminCommandStatus {
  PENDING
  APPROVED
  REJECTED
  EXECUTED
}

enum AdminApprovalDecision {
  APPROVED
  REJECTED
}

model AdminGovernanceCommand {
  id             String                    @id @default(uuid())
  idempotencyKey String                    @unique
  commandType    String
  target         String?
  reason         String
  payload        Json?
  requestedBy    String
  status         AdminCommandStatus        @default(PENDING)
  approvedBy     String?
  approvedAt     DateTime?
  executedAt     DateTime?
  createdAt      DateTime                  @default(now())
  updatedAt      DateTime                  @updatedAt
  approvals      AdminGovernanceApproval[]

  @@index([status, createdAt])
  @@index([requestedBy, createdAt])
}

model AdminGovernanceApproval {
  id         String                 @id @default(uuid())
  commandId  String
  approverId String
  decision   AdminApprovalDecision
  reason     String
  createdAt  DateTime               @default(now())
  command    AdminGovernanceCommand @relation(fields: [commandId], references: [id], onDelete: Cascade)

  @@unique([commandId, approverId])
  @@index([approverId, createdAt])
}

enum AdminIncidentSeverity {
  INFO
  WARNING
  CRITICAL
}

model AdminIncident {
  id                            String                @id @default(uuid())
  title                         String
  body                          String
  severity                      AdminIncidentSeverity @default(INFO)
  active                        Boolean               @default(true)
  environment                   String
  postedAt                      DateTime              @default(now())
  acknowledgedAt                DateTime?
  acknowledgedBy                String?
  acknowledgementReason         String?
  acknowledgementIdempotencyKey String?               @unique
  correlationId                 String?
  createdAt                     DateTime              @default(now())
  updatedAt                     DateTime              @updatedAt

  @@index([active, postedAt])
  @@index([environment, postedAt])
}

enum AdminMaintenanceScope {
  GLOBAL
  ROUTE
  MARKET
  PAIR
}

enum AdminMaintenanceStatus {
  SCHEDULED
  ACTIVE
  COMPLETED
  CANCELLED
}

model AdminMaintenanceWindow {
  id                   String                 @id @default(uuid())
  scope                AdminMaintenanceScope
  target               String
  status               AdminMaintenanceStatus @default(SCHEDULED)
  scheduledAt          DateTime
  endsAt               DateTime
  reason               String
  environment          String
  createdBy            String
  createdAt            DateTime               @default(now())
  cancelledAt          DateTime?
  cancelledBy          String?
  cancelReason         String?
  cancelIdempotencyKey String?                @unique
  idempotencyKey       String                 @unique
  correlationId        String?
  updatedAt            DateTime               @updatedAt

  @@index([status, scheduledAt])
  @@index([scope, target])
  @@index([environment, scheduledAt])
}

model AdminFeatureFlag {
  id          String   @id @default(uuid())
  key         String   @unique
  enabled     Boolean  @default(false)
  environment String   @default("sandbox")
  reason      String
  updatedBy   String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model BinaryPair {
  id            Int     @id @default(autoincrement())
  symbol        String  @unique // e.g., "BTC/USDT"
  baseAsset     String // e.g., "BTC"
  quoteAsset    String // e.g., "USDT"
  rate          Float   @default(1.85) // Payout Rate e.g., 1.85 for 85%
  category      String  @default("crypto") // crypto, forex, metal, stock
  logo          String? // Added logo field
  isActive      Boolean @default(true)
  houseWinRatio Int     @default(50) // Global Risk: Win Ratio for the house (e.g., 60 means 60% chance user loses)

  // Real API mapping fields
  realId     Int?
  matchId    Int?
  currencyId Int?
  coinType   Int? @default(0) // 0=Crypto, 1=Stock, 2=Forex, 3=Metal

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model BinaryTimeframe {
  id          Int     @id @default(autoincrement())
  name        String // e.g., "30s", "1m"
  seconds     Int     @unique
  payoutRate  Float // e.g., 0.85
  profitRatio Int     @default(85)
  lossRatio   Int     @default(0)
  isActive    Boolean @default(true)
}

model WithdrawalRequest {
  id        String           @id @default(uuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id])
  currency  String
  amount    Float
  address   String
  status    WithdrawalStatus @default(PENDING)
  txHash    String?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
}

enum WithdrawalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum LedgerType {
  DEPOSIT
  WITHDRAWAL
  TRADE_BINARY
  LOAN_DISBURSED
  LOAN_REPAID
  CONVERSION
  AFFILIATE_REWARD
  SPOT
  BINARY
  MAIN
  MINING
  LOAN
  MINING_REWARD
  TRADE_SPOT
}

enum OrderSide {
  BUY
  SELL
}

enum OrderType {
  LIMIT
  MARKET
}

enum OrderStatus {
  OPEN
  FILLED
  PARTIALLY_FILLED
  CANCELED
  CANCELLED
}

enum BinarySide {
  CALL
  PUT
}

enum BinaryStatus {
  OPEN
  WIN
  LOSS
}

enum LoanStatus {
  PENDING
  APPROVED
  REJECTED
  ACTIVE
  PAID
  OVERDUE
  DEFAULTED
}

enum MiningStatus {
  ACTIVE
  COMPLETED
  CANCELLED
}

enum Role {
  USER
  ADMIN
}

enum TransactionStatus {
  PENDING
  CONFIRMED
  FAILED
  REJECTED
}

enum TransactionType {
  DEPOSIT
  WITHDRAWAL
  TRADE_SPOT
  TRADE_BINARY
  MINING_PAYOUT
  LOAN_DISBURSEMENT
  LOAN_REPAYMENT
  TRANSFER
}

// Historical enum types retained so the reconciled schema does not imply
// that applied enum definitions or their data were discarded.
enum UserRole {
  USER
  ADMIN
}

enum KycStatus {
  PENDING
  APPROVED
  REJECTED
  NOT_SUBMITTED
}

model OptionGameSettings {
  id         String   @id @default(uuid())
  currencyId Int
  matchId    Int
  status     Int
  symbol     String?
  payoutRate Float?
  duration   Int?
  rawData    Json?
  dummy      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model MarketData {
  id        String   @id @default(uuid())
  symbol    String   @unique
  price     Float
  change    Float
  vol       Float
  high      Float
  low       Float
  rawData   Json?
  updatedAt DateTime @updatedAt
}

enum AssetLifecycleStatus {
  ACTIVE
  MAINTENANCE
  INACTIVE
}

enum MarketQuoteState {
  LOADING
  LIVE
  STALE
  ERROR
  UNAVAILABLE
}

enum LedgerAccountStatus {
  ACTIVE
  SUSPENDED
  CLOSED
}

enum LedgerAccountScope {
  MAIN
  MARGIN
}

enum LedgerPostingKind {
  CREDIT
  DEBIT
  RESERVE
  RELEASE
  SETTLEMENT
  COMPENSATION
  TRANSFER
}

enum SpotMarginAccountStatus {
  ACTIVE
  SUSPENDED
  CLOSED
}

enum SpotMarginPositionDirection {
  LONG
  SHORT
}

enum SpotMarginPositionStatus {
  PENDING
  OPEN
  CLOSING
  CLOSED
  LIQUIDATED
}

enum SpotMarginEventType {
  TRANSFER_IN
  TRANSFER_OUT
  OPEN
  MARK
  INTEREST
  PNL
  FEE
  CLOSE
  LIQUIDATION
  COLLATERAL_RESERVE
  COLLATERAL_RELEASE
  REPAYMENT
}

enum SpotMarginActivityStatus {
  ACCEPTED
  COMPLETED
  REJECTED
}

model MarketAsset {
  id              String                  @id @default(uuid())
  symbol          String                  @unique
  displayName     String
  category        String                  @default("crypto")
  providerSymbol  String?
  status          AssetLifecycleStatus    @default(ACTIVE)
  maintenanceNote String?
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt
  networks        MarketNetwork[]
  capabilities    MarketAssetCapability[]
  basePairs       MarketPair[]            @relation("MarketPairBaseAsset")
  quotePairs      MarketPair[]            @relation("MarketPairQuoteAsset")

  @@index([category, status])
}

model MarketNetwork {
  id              String                  @id @default(uuid())
  assetId         String
  code            String
  name            String
  status          AssetLifecycleStatus    @default(ACTIVE)
  maintenanceNote String?
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt
  asset           MarketAsset             @relation(fields: [assetId], references: [id])
  capabilities    MarketAssetCapability[]

  @@unique([assetId, code])
  @@index([code, status])
}

model MarketAssetCapability {
  id              String               @id @default(uuid())
  assetId         String
  networkId       String?
  capabilityKey   String               @unique
  depositEnabled  Boolean              @default(false)
  withdrawEnabled Boolean              @default(false)
  tradingEnabled  Boolean              @default(false)
  status          AssetLifecycleStatus @default(ACTIVE)
  maintenanceNote String?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  asset           MarketAsset          @relation(fields: [assetId], references: [id])
  network         MarketNetwork?       @relation(fields: [networkId], references: [id])

  @@index([assetId, status])
  @@index([networkId])
}

model MarketPair {
  id              String                 @id @default(uuid())
  symbol          String                 @unique
  baseAssetId     String
  quoteAssetId    String
  category        String                 @default("crypto")
  status          AssetLifecycleStatus   @default(ACTIVE)
  maintenanceNote String?
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt
  baseAsset       MarketAsset            @relation("MarketPairBaseAsset", fields: [baseAssetId], references: [id])
  quoteAsset      MarketAsset            @relation("MarketPairQuoteAsset", fields: [quoteAssetId], references: [id])
  snapshots       MarketQuoteSnapshot[]
  latest          MarketQuoteLatest?
  klines          MarketKline[]
  providerSymbols MarketProviderSymbol[]
  trades          MarketTrade[]
  depthSnapshots  MarketDepthSnapshot[]

  @@unique([baseAssetId, quoteAssetId])
  @@index([category, status])
}

enum MarketProviderLifecycleStatus {
  ACTIVE
  DISABLED
  MAINTENANCE
}

model MarketProviderConfig {
  id               String                        @id @default(uuid())
  key              String                        @unique
  displayName      String
  status           MarketProviderLifecycleStatus @default(ACTIVE)
  priority         Int                           @default(100)
  restBaseUrl      String?
  websocketBaseUrl String?
  supportsQuotes   Boolean                       @default(true)
  supportsKlines   Boolean                       @default(true)
  supportsTrades   Boolean                       @default(false)
  supportsDepth    Boolean                       @default(false)
  createdAt        DateTime                      @default(now())
  updatedAt        DateTime                      @updatedAt
  symbols          MarketProviderSymbol[]

  @@index([status, priority])
}

model MarketProviderSymbol {
  id             String               @id @default(uuid())
  providerId     String
  pairId         String
  providerSymbol String
  enabled        Boolean              @default(true)
  priority       Int                  @default(100)
  capabilityPolicy Json?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  provider       MarketProviderConfig @relation(fields: [providerId], references: [id])
  pair           MarketPair           @relation(fields: [pairId], references: [id])

