# Canonical NEXI public frontend deployment endpoints
NEXT_PUBLIC_API_URL=https://api.nexitrading.app
NEXT_PUBLIC_PLATFORM_URL=https://app.nexitrading.app

# Public runtime feature wiring
NEXT_PUBLIC_CONVERSION_ENABLED=true
NEXT_PUBLIC_ANNOUNCEMENT_ENDPOINT=/communications/announcements
NEXT_PUBLIC_MESSAGES_ENDPOINT=/communications/messages
NEXT_PUBLIC_MINING_PLANS_ENDPOINT=/mining/plans
NEXT_PUBLIC_MINING_POSITIONS_ENDPOINT=/mining/my/{userId}
NEXT_PUBLIC_MINING_SUBSCRIBE_ENDPOINT=/mining/subscribe

# Observability (values supplied at deploy time)
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_ENVIRONMENT=staging
NEXT_PUBLIC_SENTRY_RELEASE=

# Optional wallet RPC override; keep empty to use configured fallback.
NEXT_PUBLIC_WALLET_RPC_URL=

# Local UI QA only. Ignored by WalletAccessGate in production builds.
NEXT_PUBLIC_NEXI_UI_QA_BYPASS_WALLET_ENVIRONMENT=0
