  @@index([positionId, createdAt])
  @@index([type, createdAt])
}

model SpotMarginActivity {
  id             String                   @id @default(uuid())
  userId         String
  accountId      String?
  positionId     String?
  type           SpotMarginEventType
  status         SpotMarginActivityStatus @default(COMPLETED)
  idempotencyKey String                   @unique
