      "cwd": "/home/mellonelay1999/workspaces/Nexi",
      "enabled": true,
      "timeout": 120000
    },
    "fallow": {
      "type": "local",
      "command": [
        "fallow-mcp"
      ],
      "cwd": "/home/mellonelay1999/workspaces/Nexi",
