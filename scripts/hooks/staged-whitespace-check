#!/bin/sh
set -eu
repo_root=$(git rev-parse --show-toplevel)
cd "$repo_root"

if git rev-parse --verify HEAD >/dev/null 2>&1; then
  against=HEAD
else
  against=$(git hash-object -t tree /dev/null)
fi

# Keep the standard staged whitespace check. Prisma client files are generated,
# so their generator-emitted whitespace is not a reason to block source commits.
exec git diff-index --check --cached "$against" -- . ':(exclude)backend/src/prisma/d1-client/**'
