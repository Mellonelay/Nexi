  miningRewardAccrual MiningRewardAccrual?
  loanRepayment       LegacyLoanRepayment?

  @@index([userId, createdAt])
  @@index([userId, type, createdAt])
  @@index([referenceType, referenceId])
  @@index([ledgerCorrelationId])
}

enum OutboxDeliveryState {
  PENDING
  PUBLISHED
  RETRY
  DEAD_LETTERED
}

model EventOutbox {
  id             String              @id @default(uuid())
  idempotencyKey String              @unique
  aggregateType  String
  aggregateId    String
  eventType      String
  eventVersion   Int                 @default(1)
  correlationId  String?
  payload        Json
  state          OutboxDeliveryState @default(PENDING)
  availableAt    DateTime            @default(now())
  claimedAt      DateTime?
  leaseToken     String?
  attempts       Int                 @default(0)
  lastErrorCode  String?
  lastErrorAt    DateTime?
  publishedAt    DateTime?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  @@index([state, availableAt])
  @@index([aggregateType, aggregateId, createdAt])
  @@index([correlationId, createdAt])
}

model LearnArticle {
  id          String                 @id @default(uuid())
  slug        String                 @unique
  title       String
  body        String
  summary     String?
  status      String                 @default("DRAFT")
  attachments Json?
  categoryId  String?
  scheduledAt DateTime?
  publishedAt DateTime?
  archivedAt  DateTime?
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt
  category    LearnCategory?         @relation(fields: [categoryId], references: [id])
  revisions   LearnArticleRevision[]
  tags        LearnArticleTag[]
  media       LearnMediaAsset[]      @relation("ArticleMedia")

  @@index([status, publishedAt])
  @@index([categoryId, status])
  @@map("LearnContent")
}

model LearnCategory {
  id          String         @id @default(uuid())
  slug        String         @unique
  name        String
  description String?
  sortOrder   Int            @default(0)
  status      String         @default("ACTIVE")
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  articles    LearnArticle[]
}

model LearnArticleRevision {
  id          String            @id @default(uuid())
  articleId   String
  revision    Int
  title       String
  body        String
  summary     String?
  status      String            @default("DRAFT")
  attachments Json?
  scheduledAt DateTime?
  publishedAt DateTime?
  archivedAt  DateTime?
  createdBy   String?
  createdAt   DateTime          @default(now())
  article     LearnArticle      @relation(fields: [articleId], references: [id], onDelete: Cascade)
  media       LearnMediaAsset[] @relation("RevisionMedia")

  @@unique([articleId, revision])
  @@index([articleId, createdAt])
}

model LearnTag {
  id        String            @id @default(uuid())
  slug      String            @unique
