  tag       LearnTag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([articleId, tagId])
  @@index([tagId])
}

model LearnMediaAsset {
  id         String                @id @default(uuid())
  articleId  String?
  revisionId String?
  url        String
  altText    String?
  provider   String?
  metadata   String?
  createdAt  DateTime              @default(now())
  article    LearnArticle?         @relation("ArticleMedia", fields: [articleId], references: [id], onDelete: Cascade)
  revision   LearnArticleRevision? @relation("RevisionMedia", fields: [revisionId], references: [id], onDelete: Cascade)

  @@index([articleId, createdAt])
  @@index([revisionId, createdAt])
}

model LegacySettings {
  id        String   @id
  key       String   @unique
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime

  @@map("Settings")
}

model UserPreference {
  id                   String   @id @default(uuid())
  userId               String   @unique
  locale               String   @default("en")
  timezone             String   @default("UTC")
  theme                String   @default("dark")
  notificationSettings String?
  tradingSettings      String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VipLevel {
  id         String         @id
  level      Int            @unique
  name       String
  threshold  String         @default("0")
  benefits   String?
  enabled    Boolean        @default(true)
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @default(now())
  userStates UserVipState[]

  @@index([enabled, level])
}

model UserVipState {
  id          String    @id
  userId      String    @unique
  vipLevelId  String
  progress    String    @default("0")
  evaluatedAt DateTime  @default(now())
  qualifiedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @default(now())
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  vipLevel    VipLevel  @relation(fields: [vipLevelId], references: [id], onDelete: Restrict)

  @@index([vipLevelId, progress])
}

// Gate 2 authority models. These coexist with historical Float-backed
// projections so B4-B6 can adopt exact NUMERIC arithmetic without rewriting
// legacy rows or changing the completed B1-B3 lineage.
enum Gate2SpotOrderType {
  LIMIT
  MARKET
  STOP
}

enum Gate2SpotOrderStatus {
  OPEN
  PARTIALLY_FILLED
  FILLED
  CANCELED
  REJECTED
}

model Gate2SpotOrder {
  id                String               @id @default(uuid())
  userId            String
  pair              String
  baseAsset         String
  quoteAsset        String
  side              OrderSide
  type              Gate2SpotOrderType
  status            Gate2SpotOrderStatus @default(OPEN)
  amount            String
  filled            String               @default("0")
  remaining         String
  price             String?
  stopPrice         String?
  triggeredAt       DateTime?
  triggerQuoteId    String?
  triggerProvider   String?
  triggerSource     String?
  triggerObservedAt DateTime?
  triggerSequence   String?
  reserveAsset      String
  reserveScope      LedgerAccountScope   @default(MAIN)
  reservedAmount    String
  feeRate           String               @default("0")
  idempotencyKey    String
  correlationId     String
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  user              User                 @relation(fields: [userId], references: [id])
  tradesAsBuyer     Gate2SpotTrade[]     @relation("Gate2TradeBuyerOrder")
  tradesAsSeller    Gate2SpotTrade[]     @relation("Gate2TradeSellerOrder")

  @@unique([userId, idempotencyKey])
  @@index([pair, status, side, price, createdAt])
  @@index([userId, status, createdAt])
}

model Gate2SpotTrade {
  id             String         @id @default(uuid())
  buyerOrderId   String
  sellerOrderId  String
  pair           String
  baseAsset      String
  quoteAsset     String
  price          String
  amount         String
  buyerFee       String         @default("0")
  sellerFee      String         @default("0")
  idempotencyKey String         @unique
  createdAt      DateTime       @default(now())
  buyerOrder     Gate2SpotOrder @relation("Gate2TradeBuyerOrder", fields: [buyerOrderId], references: [id])
  sellerOrder    Gate2SpotOrder @relation("Gate2TradeSellerOrder", fields: [sellerOrderId], references: [id])

  @@index([pair, createdAt])
  @@index([buyerOrderId, createdAt])
  @@index([sellerOrderId, createdAt])
}

model Gate2BinaryConfiguration {
  id                     String   @id @default(uuid())
  pair                   String
  durationSeconds        Int
  payoutRate             String
  lossRate               String   @default("0")
  minStake               String
  maxStake               String
  settlementDelaySeconds Int      @default(0)
  version                Int      @default(1)
  enabled                Boolean  @default(true)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  @@unique([pair, durationSeconds, version])
  @@index([pair, enabled])
}

enum Gate2BinaryState {
  ACTIVE
  SETTLING
  SETTLEMENT_DELAYED
  WIN
  LOSS
  ERROR
}

model Gate2BinaryPosition {
  id                   String           @id @default(uuid())
  userId               String
  pair                 String
  side                 BinarySide
  stake                String
  entryPrice           String
  expiryPrice          String?
  payoutAmount         String           @default("0")
  realizedProfit       String           @default("0")
  durationSeconds      Int
  expiresAt            DateTime
  state                Gate2BinaryState @default(ACTIVE)
  entryQuoteId         String
  entryProvider        String
  entrySource          String
  entryObservedAt      DateTime
  entryReceivedAt      DateTime
  entrySequence        String
  expiryQuoteId        String?
  expiryProvider       String?
  expirySource         String?
  expiryObservedAt     DateTime?
  expiryReceivedAt     DateTime?
  expirySequence       String?
  quoteFreshnessMs     Int
  configurationVersion Int
  settlementReceiptId  String?          @unique
  idempotencyKey       String
  correlationId        String
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt
  user                 User             @relation(fields: [userId], references: [id])

  @@unique([userId, idempotencyKey])
  @@index([userId, state, createdAt])
  @@index([pair, state, createdAt])
}

enum Gate2DepositState {
  OBSERVED
  CONFIRMING
  CREDITED
  REJECTED
  UNAVAILABLE
}

model Gate2Deposit {
  id                    String            @id @default(uuid())
  userId                String
  asset                 String
  network               String
  address               String
  txHash                String
  amount                String
  confirmations         Int               @default(0)
  requiredConfirmations Int
  state                 Gate2DepositState @default(OBSERVED)
  observationKey        String            @unique
  creditPostingId       String?
  observedAt            DateTime          @default(now())
  creditedAt            DateTime?
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt
  user                  User              @relation(fields: [userId], references: [id])

  @@unique([network, txHash, address])
  @@index([userId, state, createdAt])
}

enum Gate2WithdrawalState {
  PENDING_REVIEW
  REJECTED
  APPROVED
  SETTLED
  FAILED
}

model Gate2Withdrawal {
  id             String               @id @default(uuid())
  userId         String
  asset          String
  network        String
  address        String
  amount         String
  fee            String
  reservedAmount String
  state          Gate2WithdrawalState @default(PENDING_REVIEW)
  requestKey     String               @unique
  reserveKey     String               @unique
  reviewReason   String?
  txHash         String?
  providerState  String?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  user           User                 @relation(fields: [userId], references: [id])

  @@index([userId, state, createdAt])
}

model Gate2InternalTransfer {
  id              String   @id @default(uuid())
  fromUserId      String
  toUserId        String
  asset           String
  amount          String
  idempotencyKey  String   @unique
  debitPostingId  String
  creditPostingId String
  createdAt       DateTime @default(now())
  fromUser        User     @relation("Gate2TransferFrom", fields: [fromUserId], references: [id])
  toUser          User     @relation("Gate2TransferTo", fields: [toUserId], references: [id])

  @@index([fromUserId, createdAt])
  @@index([toUserId, createdAt])
}

enum Gate2ConversionQuoteState {
  OPEN
  ACCEPTED
  EXPIRED
  REJECTED
}

model Gate2ConversionQuote {
  id                   String                    @id @default(uuid())
  userId               String
  fromAsset            String
  toAsset              String
  inputAmount          String
  rate                 String
  outputAmount         String
  provider             String
  source               String
  evidenceId           String
  configurationVersion Int
  expiresAt            DateTime
  state                Gate2ConversionQuoteState @default(OPEN)
  quoteKey             String                    @unique
  acceptanceKey        String?                   @unique
  conversionRef        String?
  createdAt            DateTime                  @default(now())
  updatedAt            DateTime                  @updatedAt
  user                 User                      @relation(fields: [userId], references: [id])

  @@index([userId, state, expiresAt])
}

model Gate2OperationAudit {
  id             String   @id @default(uuid())
  userId         String
  operationType  String
  operationId    String
  eventType      String
  idempotencyKey String
  details        String?
  createdAt      DateTime @default(now())
  user           User     @relation(fields: [userId], references: [id])

  @@index([operationType, operationId, createdAt])
  @@index([userId, createdAt])
  @@index([idempotencyKey])
}
