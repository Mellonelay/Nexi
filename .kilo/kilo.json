{
  "$schema": "https://app.kilo.ai/config.json",
  "plugin": [
    "file:///home/mellonelay1999/workspaces/Nexi/.kilo/plugins/graphify.js"
  ],
  "mcp": {
    "graphify": {
      "type": "local",
      "command": [
        "graphify-mcp",
        "/home/mellonelay1999/workspaces/Nexi/graphify-out/graph.json"
