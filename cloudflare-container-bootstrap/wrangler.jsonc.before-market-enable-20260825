{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nexi-staging",
  "main": "src/index.js",
  "compatibility_date": "2026-08-19",
  "compatibility_flags": ["nodejs_compat"],
  "account_id": "95f40eab0f2ba20aff96f8979e45ab71",
  "observability": {
    "enabled": true
  },
  "vars": {
    "NODE_ENV": "production",
    "PORT": "3000",
    "CORS_ORIGINS": "http://127.0.0.1:3001",
    "WALLET_AUTH_DOMAIN": "127.0.0.1:3001",
    "WALLET_AUTH_URI": "http://127.0.0.1:3001",
    "WALLET_AUTH_SUPPORTED_CHAIN_IDS": "1",
    "DATABASE_POOL_MAX": "4",
    "MARKET_PROVIDER_ENABLED": "false",
    "MARKET_PROVIDER_NAME": "binance-spot",
    "MARKET_PROVIDER_NAMES": "binance-spot",
    "MARKET_PROVIDER_SYMBOLS": "canonical_crypto",
    "MARKET_PROVIDER_POLL_INTERVAL_MS": "5000",
    "MARKET_QUOTE_STALE_AFTER_MS": "30000",
    "NEXI_MARKET_STALE_AFTER_MS": "30000",
    "NEXI_CONVERSION_QUOTE_TTL_MS": "30000",
    "MARKET_BACKFILL_ON_STARTUP": "false",
    "NEXI_SCHEDULER_ENABLED": "false",
    "NEXI_B7_ENABLED": "false"
  },
  "secrets": {
    "required": [
      "DATABASE_URL",
      "REDIS_URL",
      "JWT_SECRET"
    ]
  },
  "r2_buckets": [{
    "binding": "DEPOSIT_PROOFS",
    "bucket_name": "nexi-deposit-proofs-staging",
    "preview_bucket_name": "nexi-deposit-proofs-staging"
  }],
  "containers": [
    {
      "class_name": "NexiApiContainer",
      "name": "nexi-api-staging",
      "image": "../backend/Dockerfile",
      "image_build_context": "../backend",
      "instance_type": "basic",
      "max_instances": 1,
      "ssh": {
        "enabled": true
      },
      "authorized_keys": [
        {
          "name": "mellonelay-codex-runtime",
            "public_key": "ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIBT3V8GvDXI5BP5FnBP6bFyIOF0AF45fals94iICkZ0n nexi-wrangler-sg-edge-01"
        },
        {
          "name": "mellonelay-windows-operator",
          "public_key": "ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIEDRrfjnbErxe9EH/1HMlWbNqdLAmNQuXolFZzTIypmF mellonelay-codex-runtime"
        }
      ]
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "class_name": "NexiApiContainer",
        "name": "NEXI_API_CONTAINER"
      }
    ]
  },
  "migrations": [
    {
        "new_sqlite_classes": [
        "NexiApiContainer"
      ],
      "tag": "v2-api-container"
    }
  ]
}
