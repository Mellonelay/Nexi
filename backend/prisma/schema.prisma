  quantity        Decimal         @db.Decimal(38, 18)
  observedAt      DateTime
  receivedAt      DateTime        @default(now())
  rawData         Json?
  pair            MarketPair      @relation(fields: [pairId], references: [id])

  @@unique([pairId, provider, providerTradeId])
  @@unique([pairId, provider, sequence])
  @@index([symbol, observedAt])
  @@index([pairId, observedAt])
}

enum MarketDepthSide {
  BID
  ASK
}

model MarketDepthSnapshot {
  id                 String             @id @default(uuid())
  pairId             String
  symbol             String
  provider           String
  source             String
